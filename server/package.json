{
  "name": "chess-coach-server",
  "version": "0.17.0",
  "private": true,
  "description": "Chess Coach web backend: documents, sign-in, coach and the site over Postgres.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "admin": "tsx src/admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@node-rs/argon2": "^2.2.2",
    "chess.js": "^1.4.0",
    "hono": "^4.7.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vitest": "^5.0.3"
  }
}
